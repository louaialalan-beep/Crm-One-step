# Crm-One-step FastAPI Backend Configuration
APP_NAME="Crm-One-step Enterprise API"
APP_ENV="development"
API_V1_STR="/api/v1"

# PostgreSQL 15+ Async Connection (asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/crm_one_step"

# Redis for ARQ Background Task Queue
REDIS_URL="redis://localhost:6379/0"

# JWT & Security
JWT_SECRET_KEY="change-this-super-secret-jwt-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# ZATCA Phase 1 (فاتورة - المرحلة الأولى) Defaults
ZATCA_DEFAULT_SELLER_NAME="Crm-One-step Enterprise"
ZATCA_DEFAULT_VAT_NUMBER="310122393500003"
ZATCA_VAT_RATE=0.15

# Meta Conversions API (CAPI)
META_GRAPH_API_VERSION="v21.0"
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
