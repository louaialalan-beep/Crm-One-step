# ==============================================================================
# Crm-One-step SaaS Platform — Environment Configuration (.env.example)
# All non-sensitive variables include ready-to-run defaults.
# External integration keys are optional (empty by default).
# ==============================================================================

# 1. Frontend & API Routing
# Empty by default in local preview so Preview Mode works; set to "/api/v1" inside docker-compose.yml
VITE_API_URL=""
APP_NAME="Crm-One-step"
APP_ENV="development"
API_V1_STR="/api/v1"

# 2. PostgreSQL 16 (Row-Level Security Multi-Tenant Database)
POSTGRES_USER="crm_user"
POSTGRES_PASSWORD="changeme_local_dev_pass"
POSTGRES_DB="crm_one_step"
DATABASE_URL="postgresql+asyncpg://crm_user:changeme_local_dev_pass@db:5432/crm_one_step"

# 3. Redis 7 & ARQ Background Queue
REDIS_URL="redis://redis:6379/0"

# 4. JWT Authentication & Security (Auto-generated at startup if left empty)
JWT_SECRET=""
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
META_ENCRYPTION_KEY=""

# 5. ZATCA Phase 1 (الفوترة الإلكترونية السعودية - المرحلة الأولى)
ZATCA_DEFAULT_SELLER_NAME="Crm-One-step Demo"
ZATCA_DEFAULT_VAT_NUMBER="300000000000003"
ZATCA_VAT_RATE=0.15

# 6. Meta WhatsApp Cloud API & Conversions API (CAPI) — Optional
META_GRAPH_API_VERSION="v21.0"
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
META_WEBHOOK_VERIFY_TOKEN=""
META_APP_SECRET=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# 7. Transactional Email (SMTP via ARQ Worker) — Optional
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME=""
SMTP_USE_TLS=true

# 8. Unified Payment Gateway Adapter (Moyasar / Tap / Stripe) — Optional Keys
PAYMENT_PROVIDER="moyasar"
PAYMENT_MOYASAR_SECRET_KEY=""
PAYMENT_TAP_SECRET_KEY=""
PAYMENT_STRIPE_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""
PAYMENT_SUCCESS_URL="http://localhost/settings/subscription?status=success"
PAYMENT_CANCEL_URL="http://localhost/settings/subscription?status=cancel"
