rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isTokenAdmin() {
      return isVerifiedUser() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'super_admin' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleId in ['role_exec_director', 'role_ceo', 'super_admin']
        )
      );
    }

    function isAdmin() {
      return isTokenAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isNonEmptyStr(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isOptionalStr(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOwnerResource() {
      return isSignedIn() && (existing().ownerId == request.auth.uid || isTokenAdmin());
    }

    function isSameTenantOrg() {
      return !('org_id' in existing()) || ('org_id' in incoming() && incoming().org_id == existing().org_id);
    }

    // 3. Entity Blueprint Validators
    function isValidOrganization(data) {
      return data.keys().hasAll(['org_id', 'name', 'plan', 'seats_limit', 'active_users_count', 'addons', 'created_by', 'created_at'])
        && data.keys().hasOnly(['id', 'org_id', 'ownerId', 'name', 'plan', 'seats_limit', 'active_users_count', 'addons', 'created_by', 'created_at', 'createdAt', 'updatedAt'])
        && isValidId(data.org_id)
        && isOptionalStr(data, 'id', 128)
        && isOptionalStr(data, 'ownerId', 128)
        && isNonEmptyStr(data.name, 140)
        && data.plan in ['Starter', 'Pro', 'Enterprise']
        && data.seats_limit is number && data.seats_limit >= 1 && data.seats_limit <= 10000
        && data.active_users_count is number && data.active_users_count >= 0 && data.active_users_count <= 10000
        && data.addons is map
        && isNonEmptyStr(data.created_by, 128)
        && isNonEmptyStr(data.created_at, 60);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'profileId', 'roleId', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'org_id', 'fullName', 'email', 'jobTitle', 'profileId', 'roleId', 'department', 'avatarUrl', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && isOptionalStr(data, 'org_id', 128)
        && isNonEmptyStr(data.fullName, 120)
        && isNonEmptyStr(data.email, 160)
        && isOptionalStr(data, 'jobTitle', 120)
        && isValidId(data.profileId)
        && isValidId(data.roleId)
        && isOptionalStr(data, 'department', 100)
        && isOptionalStr(data, 'avatarUrl', 500)
        && data.status in ['active', 'inactive']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['ownerId', 'name', 'isSystem', 'modulePermissions', 'fieldSecurity', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'org_id', 'name', 'description', 'isSystem', 'modulePermissions', 'fieldSecurity', 'addonPermissions', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isOptionalStr(data, 'org_id', 128)
        && isNonEmptyStr(data.name, 100)
        && isOptionalStr(data, 'description', 400)
        && data.isSystem is bool
        && data.modulePermissions is map
        && data.fieldSecurity is map
        && (!('addonPermissions' in data) || data.addonPermissions is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRole(data) {
      return data.keys().hasAll(['ownerId', 'name', 'dataVisibility', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'org_id', 'name', 'reportsToRoleId', 'dataVisibility', 'hide_subordinates_data', 'description', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isOptionalStr(data, 'org_id', 128)
        && isNonEmptyStr(data.name, 100)
        && isOptionalStr(data, 'reportsToRoleId', 128)
        && data.dataVisibility in ['private', 'team', 'organization']
        && (!('hide_subordinates_data' in data) || data.hide_subordinates_data is bool)
        && isOptionalStr(data, 'description', 300)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomField(data) {
      return data.keys().hasAll(['ownerId', 'module', 'fieldKey', 'label', 'fieldType', 'section', 'required', 'order', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'org_id', 'module', 'fieldKey', 'api_name', 'label', 'fieldType', 'section', 'required', 'order', 'options', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isOptionalStr(data, 'org_id', 128)
        && data.module in ['leads', 'contacts', 'accounts', 'deals', 'quotes', 'sales_orders', 'invoices', 'tasks']
        && isNonEmptyStr(data.fieldKey, 80)
        && data.fieldKey.matches('^[a-zA-Z0-9_]+$')
        && isOptionalStr(data, 'api_name', 100)
        && isNonEmptyStr(data.label, 100)
        && data.fieldType in ['text', 'number', 'currency', 'select', 'date', 'boolean', 'email', 'phone']
        && isNonEmptyStr(data.section, 100)
        && data.required is bool
        && data.order is number
        && data.order >= 0 && data.order <= 1000
        && (!('options' in data) || (data.options is list && data.options.size() <= 30 && (data.options.size() == 0 || data.options[0] is string)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLead(data) {
      return data.keys().hasAll(['ownerId', 'unique_id', 'fullName', 'status', 'aiScore', 'estimatedValue', 'assignedToName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'org_id', 'unique_id', 'fullName', 'company', 'jobTitle', 'email', 'phone', 'altContact',
          'source', 'channel', 'campaign', 'adId', 'utmSource', 'utmMedium', 'utmCampaign',
          'status', 'aiScore', 'estimatedValue', 'approvedBudget', 'assignedToName', 'city', 'tags',
          'lastActivityLabel', 'lastMessageSnippet', 'awaitingReplyHours', 'followUpAt', 'notes',
          'converted', 'convertedAt', 'convertedContactId', 'convertedAccountId', 'convertedDealId',
          'customValues', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && isOptionalStr(data, 'org_id', 128)
        && isNonEmptyStr(data.unique_id, 16)
        && data.unique_id.matches('^RWQ-[0-9]{5}$')
        && isNonEmptyStr(data.fullName, 120)
        && isOptionalStr(data, 'company', 140)
        && isOptionalStr(data, 'jobTitle', 100)
        && isOptionalStr(data, 'email', 160)
        && isOptionalStr(data, 'phone', 40)
        && isOptionalStr(data, 'altContact', 160)
        && isOptionalStr(data, 'source', 80)
        && (!('channel' in data) || data.channel in ['whatsapp', 'instagram', 'messenger', 'website', 'phone', 'referral'])
        && isOptionalStr(data, 'campaign', 140)
        && isOptionalStr(data, 'adId', 80)
        && isOptionalStr(data, 'utmSource', 80)
        && isOptionalStr(data, 'utmMedium', 80)
        && isOptionalStr(data, 'utmCampaign', 80)
        && data.status in ['جديد', 'تم التواصل', 'مؤهل للتحويل', 'غير مهتم']
        && data.aiScore is number && data.aiScore >= 0 && data.aiScore <= 100
        && data.estimatedValue is number && data.estimatedValue >= 0
        && (!('approvedBudget' in data) || (data.approvedBudget is number && data.approvedBudget >= 0))
        && isNonEmptyStr(data.assignedToName, 120)
        && isOptionalStr(data, 'city', 80)
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20 && (data.tags.size() == 0 || data.tags[0] is string)))
        && isOptionalStr(data, 'lastActivityLabel', 80)
        && isOptionalStr(data, 'lastMessageSnippet', 300)
        && (!('awaitingReplyHours' in data) || (data.awaitingReplyHours is number && data.awaitingReplyHours >= 0))
        && isOptionalStr(data, 'followUpAt', 40)
        && isOptionalStr(data, 'notes', 1000)
        && (!('converted' in data) || data.converted is bool)
        && isOptionalStr(data, 'convertedAt', 40)
        && isOptionalStr(data, 'convertedContactId', 128)
        && isOptionalStr(data, 'convertedAccountId', 128)
        && isOptionalStr(data, 'convertedDealId', 128)
        && (!('customValues' in data) || data.customValues is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidContact(data) {
      return data.keys().hasAll(['ownerId', 'fullName', 'accountId', 'accountName', 'isPrimary', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'org_id', 'fullName', 'accountId', 'accountName', 'jobTitle', 'email', 'phone', 'city',
          'isPrimary', 'leadUniqueId', 'primarySource', 'contactStatus', 'channel', 'assignedToName',
          'tags', 'lastActivityLabel', 'lastMessageSnippet', 'notes', 'customValues', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && isOptionalStr(data, 'org_id', 128)
        && isNonEmptyStr(data.fullName, 120)
        && isNonEmptyStr(data.accountId, 128)
        && isNonEmptyStr(data.accountName, 140)
        && isOptionalStr(data, 'jobTitle', 100)
        && isOptionalStr(data, 'email', 160)
        && isOptionalStr(data, 'phone', 40)
        && isOptionalStr(data, 'city', 80)
        && data.isPrimary is bool
        && isOptionalStr(data, 'leadUniqueId', 16)
        && isOptionalStr(data, 'primarySource', 120)
        && isOptionalStr(data, 'contactStatus', 80)
        && (!('channel' in data) || data.channel in ['whatsapp', 'instagram', 'messenger', 'website', 'phone', 'referral'])
        && isOptionalStr(data, 'assignedToName', 120)
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20 && (data.tags.size() == 0 || data.tags[0] is string)))
        && isOptionalStr(data, 'lastActivityLabel', 80)
        && isOptionalStr(data, 'lastMessageSnippet', 300)
        && isOptionalStr(data, 'notes', 1000)
        && (!('customValues' in data) || data.customValues is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['ownerId', 'name', 'industry', 'tier', 'annualRevenue', 'accountManager', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'org_id', 'name', 'industry', 'city', 'tier', 'annualRevenue', 'employeesCount', 'website', 'accountManager', 'leadUniqueId', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isOptionalStr(data, 'org_id', 128)
        && isNonEmptyStr(data.name, 150)
        && isNonEmptyStr(data.industry, 100)
        && isOptionalStr(data, 'city', 80)
        && data.tier in ['استراتيجي', 'مؤسسات', 'نمو']
        && data.annualRevenue is number && data.annualRevenue >= 0
        && (!('employeesCount' in data) || (data.employeesCount is number && data.employeesCount >= 0))
        && isOptionalStr(data, 'website', 200)
        && isNonEmptyStr(data.accountManager, 120)
        && isOptionalStr(data, 'leadUniqueId', 16)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDeal(data) {
      return data.keys().hasAll(['ownerId', 'title', 'accountId', 'accountName', 'amount', 'currency', 'stage', 'probability', 'closeDate', 'ownerName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'org_id', 'title', 'accountId', 'accountName', 'amount', 'currency', 'stage', 'probability', 'closeDate', 'ownerName', 'nextStep', 'leadUniqueId', 'contactId', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isOptionalStr(data, 'org_id', 128)
        && isNonEmptyStr(data.title, 160)
        && isNonEmptyStr(data.accountId, 128)
        && isNonEmptyStr(data.accountName, 150)
        && data.amount is number && data.amount >= 0
        && data.currency in ['SAR', 'USD', 'AED']
        && data.stage in ['تأهيل مبدئي', 'تحديد الاحتياج', 'عرض سعر', 'تفاوض', 'مكتملة', 'خسارة']
        && data.probability is number && data.probability >= 0 && data.probability <= 100
        && isNonEmptyStr(data.closeDate, 40)
        && isNonEmptyStr(data.ownerName, 120)
        && isOptionalStr(data, 'nextStep', 200)
        && isOptionalStr(data, 'leadUniqueId', 16)
        && isOptionalStr(data, 'contactId', 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuote(data) {
      return data.keys().hasAll(['ownerId', 'quoteNumber', 'subject', 'dealId', 'accountName', 'totalAmount', 'status', 'validUntil', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'org_id', 'quoteNumber', 'subject', 'dealId', 'accountName', 'totalAmount', 'status', 'validUntil', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isOptionalStr(data, 'org_id', 128)
        && isNonEmptyStr(data.quoteNumber, 40)
        && isNonEmptyStr(data.subject, 160)
        && isNonEmptyStr(data.dealId, 128)
        && isNonEmptyStr(data.accountName, 150)
        && data.totalAmount is number && data.totalAmount >= 0
        && data.status in ['مسودة', 'مرسل', 'مؤهل', 'مكتملة', 'خسارة']
        && isNonEmptyStr(data.validUntil, 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSalesOrder(data) {
      return data.keys().hasAll(['ownerId', 'orderNumber', 'accountName', 'totalAmount', 'status', 'deliveryDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'org_id', 'orderNumber', 'quoteId', 'accountName', 'totalAmount', 'status', 'deliveryDate', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isOptionalStr(data, 'org_id', 128)
        && isNonEmptyStr(data.orderNumber, 40)
        && isOptionalStr(data, 'quoteId', 128)
        && isNonEmptyStr(data.accountName, 150)
        && data.totalAmount is number && data.totalAmount >= 0
        && data.status in ['قيد التجهيز', 'مؤهل', 'مكتملة', 'مؤجلة']
        && isNonEmptyStr(data.deliveryDate, 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['ownerId', 'invoiceNumber', 'accountName', 'totalAmount', 'paidAmount', 'status', 'dueDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'org_id', 'invoiceNumber', 'salesOrderId', 'accountName', 'totalAmount', 'paidAmount', 'status', 'dueDate', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isOptionalStr(data, 'org_id', 128)
        && isNonEmptyStr(data.invoiceNumber, 40)
        && isOptionalStr(data, 'salesOrderId', 128)
        && isNonEmptyStr(data.accountName, 150)
        && data.totalAmount is number && data.totalAmount >= 0
        && data.paidAmount is number && data.paidAmount >= 0
        && data.status in ['مكتملة', 'مؤجلة', 'متأخرة', 'مسودة']
        && isNonEmptyStr(data.dueDate, 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTouchpoint(data) {
      return data.keys().hasAll(['ownerId', 'channel', 'summary', 'relatedEntityType', 'relatedEntityId', 'relatedEntityName', 'occurredAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'org_id', 'channel', 'summary', 'relatedEntityType', 'relatedEntityId', 'relatedEntityName', 'occurredAt', 'leadId', 'leadUniqueId', 'campaign', 'adId', 'utmSource', 'eventType', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isOptionalStr(data, 'org_id', 128)
        && data.channel in ['مكالمة', 'اجتماع', 'بريد إلكتروني', 'واتساب', 'إنستغرام', 'موقع ويب', 'حدث']
        && isNonEmptyStr(data.summary, 300)
        && isNonEmptyStr(data.relatedEntityType, 60)
        && isNonEmptyStr(data.relatedEntityId, 128)
        && isNonEmptyStr(data.relatedEntityName, 140)
        && isNonEmptyStr(data.occurredAt, 40)
        && isOptionalStr(data, 'leadId', 128)
        && isOptionalStr(data, 'leadUniqueId', 16)
        && isOptionalStr(data, 'campaign', 140)
        && isOptionalStr(data, 'adId', 80)
        && isOptionalStr(data, 'utmSource', 80)
        && isOptionalStr(data, 'eventType', 140)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['ownerId', 'channel', 'senderName', 'body', 'direction', 'unread', 'timestampLabel', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'org_id', 'channel', 'senderName', 'companyName', 'subject', 'body', 'direction', 'unread', 'timestampLabel', 'leadId', 'leadUniqueId', 'campaign', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isOptionalStr(data, 'org_id', 128)
        && data.channel in ['whatsapp', 'email', 'chat', 'instagram', 'messenger']
        && isNonEmptyStr(data.senderName, 120)
        && isOptionalStr(data, 'companyName', 140)
        && isOptionalStr(data, 'subject', 160)
        && isNonEmptyStr(data.body, 2000)
        && data.direction in ['inbound', 'outbound']
        && data.unread is bool
        && isNonEmptyStr(data.timestampLabel, 60)
        && isOptionalStr(data, 'leadId', 128)
        && isOptionalStr(data, 'leadUniqueId', 16)
        && isOptionalStr(data, 'campaign', 140)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['ownerId', 'title', 'priority', 'status', 'dueDate', 'relatedTo', 'assignedToName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'org_id', 'title', 'priority', 'status', 'dueDate', 'relatedTo', 'assignedToName', 'leadId', 'leadUniqueId', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isOptionalStr(data, 'org_id', 128)
        && isNonEmptyStr(data.title, 160)
        && data.priority in ['عالية', 'متوسطة', 'منخفضة']
        && data.status in ['قيد التنفيذ', 'مكتملة', 'مؤجلة']
        && isNonEmptyStr(data.dueDate, 40)
        && isNonEmptyStr(data.relatedTo, 140)
        && isNonEmptyStr(data.assignedToName, 120)
        && isOptionalStr(data, 'leadId', 128)
        && isOptionalStr(data, 'leadUniqueId', 16)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBlueprint(data) {
      return data.keys().hasAll(['ownerId', 'name', 'module', 'active', 'stagesCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'org_id', 'name', 'module', 'active', 'stagesCount', 'description', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isOptionalStr(data, 'org_id', 128)
        && isNonEmptyStr(data.name, 120)
        && isNonEmptyStr(data.module, 60)
        && data.active is bool
        && data.stagesCount is number && data.stagesCount >= 1 && data.stagesCount <= 30
        && isOptionalStr(data, 'description', 300)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkflow(data) {
      return data.keys().hasAll(['ownerId', 'name', 'module', 'trigger', 'actionSummary', 'active', 'executionsCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'org_id', 'name', 'module', 'trigger', 'actionSummary', 'active', 'executionsCount', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isOptionalStr(data, 'org_id', 128)
        && isNonEmptyStr(data.name, 120)
        && isNonEmptyStr(data.module, 60)
        && isNonEmptyStr(data.trigger, 120)
        && isNonEmptyStr(data.actionSummary, 200)
        && data.active is bool
        && data.executionsCount is number && data.executionsCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRecycleBinItem(data) {
      return data.keys().hasAll(['ownerId', 'entityType', 'originalId', 'displayName', 'deletedBy', 'deletedAtLabel', 'expiresInDays', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'org_id', 'entityType', 'originalId', 'displayName', 'deletedBy', 'deletedAtLabel', 'expiresInDays', 'payloadJson', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isOptionalStr(data, 'org_id', 128)
        && isNonEmptyStr(data.entityType, 60)
        && isNonEmptyStr(data.originalId, 128)
        && isNonEmptyStr(data.displayName, 160)
        && isNonEmptyStr(data.deletedBy, 120)
        && isNonEmptyStr(data.deletedAtLabel, 60)
        && data.expiresInDays is number && data.expiresInDays >= 0 && data.expiresInDays <= 365
        && isOptionalStr(data, 'payloadJson', 10000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMetaConnection(data) {
      return data.keys().hasAll(['ownerId', 'org_id', 'fb_user_id', 'long_lived_token_enc', 'token_expires_at', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isValidId(data.org_id)
        && isNonEmptyStr(data.fb_user_id, 128)
        && isNonEmptyStr(data.long_lived_token_enc, 2000)
        && isNonEmptyStr(data.token_expires_at, 80)
        && data.status in ['connected', 'reconnect_required'];
    }

    function isValidMetaPage(data) {
      return data.keys().hasAll(['ownerId', 'org_id', 'page_id', 'page_name', 'ig_account_id', 'waba_id', 'phone_number_id', 'page_token_enc', 'subscribed_fields', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isValidId(data.org_id)
        && isNonEmptyStr(data.page_id, 128)
        && isNonEmptyStr(data.page_name, 200)
        && isNonEmptyStr(data.page_token_enc, 2000)
        && data.subscribed_fields is list;
    }

    function isValidMetaFieldMapping(data) {
      return data.keys().hasAll(['ownerId', 'org_id', 'form_id', 'mappings', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isValidId(data.org_id)
        && isNonEmptyStr(data.form_id, 128)
        && data.mappings is map;
    }

    function isValidMetaWebhookLog(data) {
      return data.keys().hasAll(['ownerId', 'org_id', 'event_id', 'event_type', 'status', 'retry_count', 'created_at', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && isValidId(data.org_id)
        && isNonEmptyStr(data.event_id, 160)
        && data.status in ['queued', 'processed', 'failed']
        && data.retry_count is number && data.retry_count >= 0;
    }

    // 4. Collection Match Blocks (All 22 Collections + admins)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && adminId == request.auth.uid;
      allow list, write: if false;
    }

    match /organizations/{orgId} {
      allow get, list: if isSignedIn();
      allow create: if isVerifiedUser()
        && isValidId(orgId)
        && isValidOrganization(incoming())
        && incoming().org_id == orgId;
      allow update: if isVerifiedUser()
        && isValidId(orgId)
        && isValidOrganization(incoming())
        && incoming().org_id == existing().org_id;
      allow delete: if isAdmin() && isValidId(orgId);

      match /settings/{settingId} {
        allow get, list: if isSignedIn();
        allow create, update: if isVerifiedUser() && isValidId(settingId);
        allow delete: if isAdmin() && isValidId(settingId);
      }

      match /integrations/{integrationId} {
        allow get, list: if isSignedIn();
